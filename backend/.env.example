# Application Settings
APP_NAME=AI-Powered Todo Chatbot
APP_DESCRIPTION=An intelligent todo management system with natural language processing
APP_VERSION=1.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
RELOAD=True

# OpenAI Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Session Settings
SESSION_TIMEOUT_HOURS=24
MAX_TODOS_PER_SESSION=1000
MAX_SESSION_MEMORY_MB=5.0

# MCP Settings
MCP_SERVER_PORT=3001